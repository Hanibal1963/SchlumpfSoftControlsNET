###############################################################################
# Zeilenenden standardmäßig automatisch normalisieren.
###############################################################################
* text=auto

###############################################################################
# Standardverhalten für den Diff in der Eingabeaufforderung festlegen.
#
# Dies wird für ältere Versionen von msysgit benötigt, bei denen es für
# C#-Dateien nicht standardmäßig aktiviert ist.
# Hinweis: Dies wird nur auf der Kommandozeile verwendet.
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Merge-Treiber für Projekt- und Projektmappendateien festlegen.
#
# Beim Zusammenführen über die Eingabeaufforderung werden bei Konflikten
# Diff-Markierungen in die Dateien eingefügt. Das Zusammenführen in VS wird
# von den folgenden Einstellungen nicht beeinflusst; dort werden niemals
# Diff-Markierungen eingefügt. Diese Markierungen können verhindern, dass
# Dateien mit den folgenden Erweiterungen in VS geladen werden. Alternativ
# können diese Dateien als Binärdateien behandelt werden. Dadurch entsteht
# immer ein Konflikt, der bei jedem Zusammenführen einen Benutzereingriff
# erfordert. Dazu die folgenden Einträge auskommentieren.
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# Verhalten für Bilddateien
#
# Bilddateien werden standardmäßig als Binärdateien behandelt.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# Diff-Verhalten für gängige Dokumentformate
#
# Binäre Dokumentformate vor dem Vergleich in Text umwandeln. Diese Funktion
# ist nur auf der Kommandozeile verfügbar. Zum Aktivieren die folgenden
# Einträge auskommentieren.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain
