!Directory.Build.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Chutzpah-Testdateien
_Chutzpah*

# Visual C++-Cachedateien
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio-Profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio-Trace-Dateien
*.e2e

# Lokaler TFS 2012-Arbeitsbereich
$tf/

# Guidance Automation Toolkit
*.gpState

# ReSharper ist ein .NET-Coding-Add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity ist ein Build-Add-in
_TeamCity*

# DotCover ist ein Code-Coverage-Tool
*.dotCover

# AxoCover ist ein Code-Coverage-Tool
.axoCover/*
!.axoCover/settings.json

# Coverlet ist ein kostenloses, plattformübergreifendes Code-Coverage-Tool
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio-Code-Coverage-Ergebnisse
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web-Workbench (sass)
.sass-cache/

# Installshield-Ausgabeordner
[Ee]xpress/

# DocProject ist ein Add-in zur Dokumentationsgenerierung
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Click-Once-Verzeichnis
publish/

# Webausgabe veröffentlichen
*.[Pp]ublish.xml
*.azurePubxml
# Hinweis: Die nächste Zeile auskommentieren, wenn Web-Deploy-Einstellungen eingecheckt werden sollen,
# aber Datenbankverbindungszeichenfolgen (mit potenziellen Passwörtern) sind dann unverschlüsselt
*.pubxml
*.publishproj

# Veröffentlichungseinstellungen für Microsoft Azure Web App. Nächste Zeile auskommentieren, wenn
# Azure Web App-Veröffentlichungseinstellungen eingecheckt werden sollen, aber sensible Informationen
# in diesen Skripten wären dann unverschlüsselt
PublishScripts/

# NuGet-Pakete
*.nupkg

# NuGet-Symbolpakete
*.snupkg

# Der Ordner packages/ kann wegen Package Restore ignoriert werden
**/[Pp]ackages/
# außer build/, da es als MSBuild-Ziel verwendet wird.
!**/[Pp]ackages/build/
# Auskommentierung aufheben, falls nötig; normalerweise wird die Datei bei Bedarf neu erzeugt
#!**/[Pp]ackages/repositories.config
# Die project.json-Dateien von NuGet v3 erzeugen weitere ignorierbare Dateien
*.nuget.props
*.nuget.targets

# Microsoft Azure-Buildausgabe
csx/
*.build.csdef

# Microsoft Azure-Emulator
ecf/
rcf/

# Verzeichnisse und Dateien für Windows Store-App-Pakete
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Visual Studio-Cachedateien
# Dateien mit Endung .cache können ignoriert werden
*.[Cc]ache
# Verzeichnisse mit Endung .cache jedoch behalten
!?*.[Cc]ache/

# Sonstiges
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Da es mehrere Workflows gibt, nächste Zeile auskommentieren, um bower_components zu ignorieren
# (https://github.com/github/gitignore/pull/1529#issuecomment-104372622)
#bower_components/

# RIA/Silverlight-Projekte
Generated_Code/

# Sicherungs- und Berichtdateien nach der Konvertierung einer alten Projektdatei
# auf eine neuere Visual Studio-Version. Sicherungsdateien werden nicht benötigt,
# weil wir Git haben ;-)
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# SQL Server-Dateien
*.mdf
*.ldf
*.ndf

# Business-Intelligence-Projekte
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# GhostDoc-Plugin-Einstellungsdatei
*.GhostDoc.xml

# Node.js-Tools für Visual Studio
.ntvs_analysis.dat
node_modules/

# Visual Studio 6-Buildprotokoll
*.plg

# Visual Studio 6-Arbeitsbereichsoptionsdatei
*.opt

# Automatisch erzeugte Visual Studio 6-Arbeitsbereichsdatei (enthält u. a. geöffnete Dateien)
*.vbw

# Visual Studio 6-Arbeitsbereichs- und Projektdatei (Arbeitsdateien mit einzubindenden Projektdateien)
*.dsw
*.dsp

# Visual Studio LightSwitch-Buildausgabe
**/*.HTMLClient/GeneratedArtifacts
**/*.DesktopClient/GeneratedArtifacts
**/*.DesktopClient/ModelManifest.xml
**/*.Server/GeneratedArtifacts
**/*.Server/ModelManifest.xml
_Pvt_Extensions

# Paket-Abhängigkeitsmanager
**/.paket/paket.exe
paket-files/

# FAKE - F# Make
**/.fake/

# Persönliche CodeRush-Einstellungen
**/.cr/personal

# Python-Tools für Visual Studio (PTVS)
**/__pycache__/
*.pyc

# Cake - Auskommentierung aufheben, wenn verwendet
#tools/**
#!tools/packages.config

# Tabs Studio
*.tss

# Konfigurationsdatei für Telerik JustMock
*.jmconfig

# BizTalk-Buildausgabe
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# OpenCover-UI-Analyseergebnisse
OpenCover/

# Lokale Azure Stream Analytics-Ausgabe
ASALocalRun/

# MSBuild-Binär- und strukturiertes Protokoll
*.binlog
MSBuild_Logs/

# AWS SAM-Build- und temporärer Artefaktordner
.aws-sam

# Konfigurationsdatei für den NVidia Nsight GPU-Debugger
*.nvuser

# Arbeitsordner von MFractors (Xamarin-Produktivitätstool)
**/.mfractor/

# Lokaler Verlauf für Visual Studio
**/.localhistory/

# Visual Studio-Verlaufsdateien (VSHistory)
.vshistory/

# Temporäre BeatPulse-Healthcheck-Datenbank
healthchecksdb

# Sicherungsordner für das Package Reference Convert-Tool in Visual Studio 2017
MigrationBackup/

# Arbeitsordner von Ionide (plattformübergreifende F#-VS-Code-Tools)
**/.ionide/

# Fody - automatisch erzeugtes XML-Schema
FodyWeavers.xsd

# VS Code-Dateien für Nutzer, die mit mehreren Tools arbeiten
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Lokaler Verlauf für Visual Studio Code
.history/

# Erstellte Visual Studio Code-Erweiterungen
*.vsix

# Windows Installer-Dateien aus Buildausgaben
*.cab
*.msi
*.msix
*.msm
*.msp

# Offizieller Ausschluss für die VS Code C# Dev Kit-Erweiterung
#*.lscache
